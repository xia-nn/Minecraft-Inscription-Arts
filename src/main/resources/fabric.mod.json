	"entrypoints": {
		"main": [
			"com.inscription_arts.InscriptionArts"
		],
		"client": [
			"com.inscription_arts.InscriptionArtsClient"
		]
	},
	"mixins": [
		"inscription_arts.mixins.json",
		{
			"config": "inscription_arts.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
